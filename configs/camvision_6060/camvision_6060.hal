# CamVision 6060 — core HAL.
#
# Preserves the working motion, spindle and pneumatic wiring from the legacy
# 6060_iCam_SPM config. Auxiliary machine I/O (indicator light tower, external
# pause/run/stop/home buttons, ClassicLadder auto-home and the safety-curtain
# interlock) lives in custom.hal, loaded next by the INI.
#
# Pin map (parallel port, two ports "e100" and "d100"):
#   parport.0 p1  spindle PWM     p2/3 X step/dir   p4/5 Y step/dir  p6/7 Z step/dir
#   parport.0 p10/11/12 home X/Y/Z   p15 e-stop (n/c)   p17 spindle-on
#   parport.1 p16 CAMERA cylinder (motion.digital-out-00)  <-- M64 P0 / M65 P0
#   parport.1 p17 safety sensor    (motion.digital-out-01) <-- M64 P1 / M65 P1

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_dio=32
loadrt hal_parport cfg="e100 out d100 out"
setp parport.0.reset-time 5000
loadrt stepgen step_type=0,0,0
loadrt pwmgen output_type=1

# threads
addf parport.0.read       base-thread
addf parport.1.read       base-thread
addf stepgen.make-pulses  base-thread
addf pwmgen.make-pulses   base-thread
addf parport.0.write      base-thread
addf parport.0.reset      base-thread
addf parport.1.write      base-thread

addf stepgen.capture-position servo-thread
addf motion-command-handler   servo-thread
addf motion-controller        servo-thread
addf stepgen.update-freq      servo-thread
addf pwmgen.update            servo-thread

# --- spindle (PWM) -------------------------------------------------------
net spindle-cmd-rpm  <= spindle.0.speed-out       => pwmgen.0.value
net spindle-on       <= spindle.0.on              => pwmgen.0.enable
setp pwmgen.0.pwm-freq 1000.0
setp pwmgen.0.scale 24000.0
setp pwmgen.0.offset 0.0
setp pwmgen.0.dither-pwm true
net spindle-at-speed => spindle.0.at-speed
sets spindle-at-speed true

net spindle-pwm <= pwmgen.0.pwm => parport.0.pin-01-out
net spindle-on  => parport.0.pin-17-out
net spindle-on  => parport.1.pin-07-out

# --- step/dir ------------------------------------------------------------
net xstep => parport.0.pin-02-out
setp parport.0.pin-02-out-reset 1
net xdir  => parport.0.pin-03-out
net ystep => parport.0.pin-04-out
setp parport.0.pin-04-out-reset 1
net ydir  => parport.0.pin-05-out
net zstep => parport.0.pin-06-out
setp parport.0.pin-06-out-reset 1
net zdir  => parport.0.pin-07-out

# --- pneumatic camera cylinder & safety sensor (M64/M65 P0/P1) ----------
net camera_up_down      <= motion.digital-out-00 => parport.1.pin-16-out
net enable_safety_sensor <= motion.digital-out-01 => parport.1.pin-17-out

# --- home / estop inputs -------------------------------------------------
net home-x <= parport.0.pin-10-in
net home-y <= parport.0.pin-11-in
net home-z <= parport.0.pin-12-in
net estop-ext <= parport.0.pin-15-in-not

# --- X joint -------------------------------------------------------------
setp stepgen.0.position-scale [JOINT_0]SCALE
setp stepgen.0.steplen 1
setp stepgen.0.stepspace 0
setp stepgen.0.dirhold 26000
setp stepgen.0.dirsetup 26000
setp stepgen.0.maxaccel [JOINT_0]STEPGEN_MAXACCEL
net xpos-cmd joint.0.motor-pos-cmd => stepgen.0.position-cmd
net xpos-fb  stepgen.0.position-fb => joint.0.motor-pos-fb
net xstep    <= stepgen.0.step
net xdir     <= stepgen.0.dir
net xenable  joint.0.amp-enable-out => stepgen.0.enable
net home-x   => joint.0.home-sw-in

# --- Y joint -------------------------------------------------------------
setp stepgen.1.position-scale [JOINT_1]SCALE
setp stepgen.1.steplen 1
setp stepgen.1.stepspace 0
setp stepgen.1.dirhold 26000
setp stepgen.1.dirsetup 26000
setp stepgen.1.maxaccel [JOINT_1]STEPGEN_MAXACCEL
net ypos-cmd joint.1.motor-pos-cmd => stepgen.1.position-cmd
net ypos-fb  stepgen.1.position-fb => joint.1.motor-pos-fb
net ystep    <= stepgen.1.step
net ydir     <= stepgen.1.dir
net yenable  joint.1.amp-enable-out => stepgen.1.enable
net home-y   => joint.1.home-sw-in

# --- Z joint -------------------------------------------------------------
setp stepgen.2.position-scale [JOINT_2]SCALE
setp stepgen.2.steplen 1
setp stepgen.2.stepspace 0
setp stepgen.2.dirhold 26000
setp stepgen.2.dirsetup 26000
setp stepgen.2.maxaccel [JOINT_2]STEPGEN_MAXACCEL
net zpos-cmd joint.2.motor-pos-cmd => stepgen.2.position-cmd
net zpos-fb  stepgen.2.position-fb => joint.2.motor-pos-fb
net zstep    <= stepgen.2.step
net zdir     <= stepgen.2.dir
net zenable  joint.2.amp-enable-out => stepgen.2.enable
net home-z   => joint.2.home-sw-in

# --- estop + manual tool change -----------------------------------------
net estop-out <= iocontrol.0.user-enable-out
net estop-ext => iocontrol.0.emc-enable-in

loadusr -W hal_manualtoolchange
net tool-change   iocontrol.0.tool-change   => hal_manualtoolchange.change
net tool-changed  iocontrol.0.tool-changed  <= hal_manualtoolchange.changed
net tool-number   iocontrol.0.tool-prep-number => hal_manualtoolchange.number
net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
